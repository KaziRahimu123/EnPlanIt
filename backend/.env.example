# AstroOps Scenario Lab — backend environment variables
# Copy this file to backend/.env and fill in your values.
# backend/.env is listed in .gitignore and must NEVER be committed.

# ── Auth0 ─────────────────────────────────────────────────────────────────
# Create a tenant at https://auth0.com and set up an API + Application.
# Domain: found on Auth0 Dashboard → Settings
AUTH0_DOMAIN=your-tenant.us.auth0.com

# API Audience: the identifier you set when creating the Auth0 API
# Must match AUTH0_AUDIENCE in frontend/.env.local
AUTH0_API_AUDIENCE=https://api.astroops.local

# Token signing algorithm (Auth0 uses RS256 by default — do not change)
AUTH0_ALGORITHMS=RS256

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL: Supabase Dashboard → Settings → API → Project URL
SUPABASE_URL=https://your-project-id.supabase.co

# Service role key: Supabase Dashboard → Settings → API → service_role secret
# WARNING: the service role key bypasses RLS — keep it server-side ONLY.
# Never expose this key in frontend code or commit it to version control.
SUPABASE_SERVICE_KEY=your-supabase-service-role-key

# ── IBM Granite / watsonx.ai (Primary Extraction Engine) ───────────────────
# Dual-pass extraction: IBM Granite 20B extracts -> GPT-5.6 Luna verifies
WATSONX_APIKEY=your-ibm-cloud-apikey
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-20b-multilingual

# Or if hosting IBM Granite locally / via gateway (e.g. Ollama/vLLM):
# GRANITE_API_BASE=http://localhost:11434/v1
# GRANITE_MODEL=ibm/granite-20b-multilingual

# ── OpenAI (Intelligent Fallback) ───────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# ── JWT Secret (for direct backend auth fallback) ─────────────────────────
JWT_SECRET_KEY=your-random-secret-key-32-chars-or-more
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── OAuth Social Logins ───────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── Application URLs ──────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
